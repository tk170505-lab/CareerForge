# CareerForge Environment Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Database Mode: sqlite (local zero-config) | mssql (Azure SQL Database)
DB_CLIENT=sqlite
SQLITE_PATH=./data/careerforge.db

# Azure SQL Database (DP-900 / Production)
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=careerforge_db
AZURE_SQL_USER=careerforge_admin
AZURE_SQL_PASSWORD=your-strong-password
AZURE_SQL_ENCRYPT=true

# Azure Blob Storage (DP-900 Certificate Storage)
STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=certificates
